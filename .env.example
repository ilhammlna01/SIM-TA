# ========================================================
# SIM-TA FEB UTM — Konfigurasi Lingkungan (Environment Variables)
# Salin file ini menjadi .env sebelum menjalankan di server produksi:
# cp .env.example .env
# ========================================================

# 1. Konfigurasi Server Utama
NODE_ENV=production
PORT=5001

# 2. Keamanan & Akses Jaringan (CORS)
# WAJIB: setel ke domain resmi kampus (boleh beberapa domain dipisah koma).
# Contoh: https://sim-ta.feb.utm.ac.id,https://feb.trunojoyo.ac.id
# JANGAN gunakan '*' di produksi (membuka API ke seluruh situs).
CORS_ORIGIN=https://sim-ta.feb.utm.ac.id

# 2a. Trust Proxy (jumlah hop reverse proxy di depan aplikasi)
# Setel 1 bila berjalan di belakang satu reverse proxy (nginx/PM2/LB) agar req.ip
# merefleksikan IP klien sebenarnya (mencegah lockout rate-limit massal).
# Setel 0 bila aplikasi terekspos langsung tanpa proxy.
TRUST_PROXY_HOPS=1

# 2b. Kunci Rahasia JWT (WAJIB DIISI DI PRODUKSI — minimal 32 karakter acak)
# Hasilkan dengan: openssl rand -hex 32
# Nilai contoh/placeholder DITOLAK oleh server. Tanpa nilai ini, server MENOLAK
# berjalan saat NODE_ENV=production.
JWT_SECRET=

# 2c. Masa berlaku token JWT (opsional, default 8h)
JWT_EXPIRES_IN=8h

# 3. URL Publik Aplikasi (Digunakan untuk tautan verifikasi QR Code & Email)
# Nama variabel dibaca oleh server/documents/pdfGenerator.js
# WAJIB disetel ke domain resmi institusi. Nilai localhost akan membuat QR Code
# pada dokumen resmi tidak dapat dipindai dari perangkat luar server.
APP_PUBLIC_URL=https://sim-ta.feb.utm.ac.id

# 3a. Batas percobaan login (rate limiting & lockout akun)
# Per IP + per akun, dan per IP global, dalam jendela 15 menit.
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=30

# 4. Konfigurasi Notifikasi Email Resmi Kampus (Opsional / SMTP Server UTM)
# Jika dikosongkan, sistem beralih otomatis ke in-app & SSE broadcasting
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# 4b. Allowlist domain email penerima (dipisah koma). Endpoint email hanya boleh
# mengirim ke domain institusi resmi; mencegah penyalahgunaan untuk phishing.
EMAIL_ALLOWED_DOMAINS=trunojoyo.ac.id

# 5. Keamanan Penyimpanan Data & Berkas
# Driver penyimpanan berkas: local | s3 | supabase
STORAGE_DRIVER=local
# Batas maksimal upload diatur per kategori di server/storage/fileValidator.js
# - Naskah/Skripsi: 15 MB (PDF)
# - Berkas Ujian/Syarat: 10 MB (PDF/JPG)
# - Scan Bimbingan Fisik: 10 MB (PDF/JPG/PNG)

# 6. Penanda untuk suite pengujian otomatis (opsional)
# Helper `tests/helpers/testAccounts.js` menyemai kredensial uji deterministik
# langsung ke SQLite agar suite dapat login konsisten TANPA mengembalikan
# kata sandi universal ke dalam aplikasi. Demi keamanan, helper ini menolak
# berjalan pada NODE_ENV=production KECUALI bila penanda berikut disetel.
# JANGAN disetel pada instance produksi sungguhan.
# ALLOW_TEST_CREDENTIALS=1

# 6a. Kredensial akun demo (KHUSUS mode pengembangan / vite dev)
# Vite hanya memuat berkas `.env.development` pada mode `vite dev`.
# Build produksi (`npm run build`) TIDAK memuat berkas tersebut, sehingga
# kredensial demo tidak pernah tertanam di bundel produksi.
# Lihat juga berkas `.env.development` (tidak di-commit).
